// Osun EduOS data model: accounts and schools (milestone 1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MINISTRY_ADMIN
  MINISTRY_OFFICER
  LGA_OFFICER
  INSPECTOR
  SCHOOL_ADMIN
  TEACHER
  PARENT
}

enum SchoolLevel {
  PRIMARY
  JUNIOR_SECONDARY
  SENIOR_SECONDARY
  JUNIOR_AND_SENIOR
}

enum Ownership {
  PUBLIC
  PRIVATE
}

model School {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique
  name              String
  lga               String
  level             SchoolLevel
  ownership         Ownership
  address           String?
  town              String?
  yearEstablished   Int?
  latitude          Float?
  longitude         Float?
  /// Classrooms as declared by the school; inspections record how many are usable.
  classrooms        Int?
  expectedEnrolment Int?
  /// e.g. WATER, TOILETS, POWER, ICT, LIBRARY, LAB, FENCE, SPORTS.
  facilities        String[]     @default([])
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  users             User[]
  classes           ClassArm[]
  students          Student[]    @relation("CurrentSchool")
  enrolments        Enrolment[]
  transfersOut      Transfer[]   @relation("TransferFrom")
  transfersIn       Transfer[]   @relation("TransferTo")
  /// Text parents when their child is marked absent. Schools can switch this off.
  absenceSms        Boolean      @default(true)
  /// Text parents when a report card is released.
  resultsSms        Boolean      @default(true)
  notices           Notice[]
  staff             Staff[]      @relation("StaffCurrentSchool")
  postings          Posting[]
  inspections       Inspection[]

  @@index([lga])
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  fullName           String
  email              String?              @unique
  phone              String?              @unique
  role               Role
  schoolId           String?              @db.Uuid
  school             School?              @relation(fields: [schoolId], references: [id])
  /// For LGA officers (required) and inspectors (optional): the one LGA they oversee. Empty means state-wide.
  lga                String?
  passwordHash       String
  mustChangePassword Boolean              @default(true)
  isActive           Boolean              @default(true)
  failedLoginCount   Int                  @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdById        String?              @db.Uuid
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  refreshTokens      RefreshToken[]
  classesTaught      ClassArm[]
  children           StudentGuardian[]
  registersTaken     AttendanceRegister[] @relation("RegisterTakenBy")
  registersUpdated   AttendanceRegister[] @relation("RegisterUpdatedBy")
  subjectsTaught     ClassSubject[]
  sheetsSubmitted    ScoreSheet[]         @relation("SheetSubmittedBy")
  sheetsDecided      ScoreSheet[]         @relation("SheetDecidedBy")
  resultsReleased    ClassResult[]
  staffRecord        Staff?
  inspections        Inspection[]
  notifications      Notification[]
  devices            DeviceToken[]

  @@index([role])
  @@index([schoolId])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String?
  targetId   String?
  schoolId   String?  @db.Uuid
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([schoolId])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Milestone 2: academic sessions, classes and students

enum ClassLevel {
  PRIMARY_1
  PRIMARY_2
  PRIMARY_3
  PRIMARY_4
  PRIMARY_5
  PRIMARY_6
  JSS_1
  JSS_2
  JSS_3
  SSS_1
  SSS_2
  SSS_3
}

enum Sex {
  F
  M
}

enum StudentStatus {
  ACTIVE
  WITHDRAWN
  GRADUATED
}

enum TransferStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
}

/// An academic year, e.g. 2025/2026. Exactly one is current; classes belong to a session.
model AcademicSession {
  id         String           @id @default(uuid()) @db.Uuid
  name       String           @unique
  startDate  DateTime         @db.Date
  endDate    DateTime         @db.Date
  isCurrent  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  classes    ClassArm[]
  placements ClassPlacement[]
  terms      Term[]
}

/// A class arm in a school for one session, e.g. JSS 2A in 2025/2026.
model ClassArm {
  id             String               @id @default(uuid()) @db.Uuid
  schoolId       String               @db.Uuid
  school         School               @relation(fields: [schoolId], references: [id])
  sessionId      String               @db.Uuid
  session        AcademicSession      @relation(fields: [sessionId], references: [id])
  level          ClassLevel
  arm            String
  capacity       Int                  @default(40)
  classTeacherId String?              @db.Uuid
  classTeacher   User?                @relation(fields: [classTeacherId], references: [id])
  createdAt      DateTime             @default(now())
  placements     ClassPlacement[]
  registers      AttendanceRegister[]
  subjects       ClassSubject[]
  results        ClassResult[]
  remarks        ReportRemark[]

  @@unique([schoolId, sessionId, level, arm])
  @@index([classTeacherId])
}

/// A learner. The learner ID is unique across Osun State and follows the student between schools.
model Student {
  id              String            @id @default(uuid()) @db.Uuid
  learnerId       String            @unique
  surname         String
  firstName       String
  middleName      String?
  sex             Sex
  dateOfBirth     DateTime          @db.Date
  stateOfOrigin   String?
  lgaOfOrigin     String?
  homeAddress     String?
  /// School attended before enrolling in EduOS, if any.
  previousSchool  String?
  status          StudentStatus     @default(ACTIVE)
  currentSchoolId String?           @db.Uuid
  currentSchool   School?           @relation("CurrentSchool", fields: [currentSchoolId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  enrolments      Enrolment[]
  placements      ClassPlacement[]
  guardians       StudentGuardian[]
  transfers       Transfer[]
  attendance      AttendanceMark[]
  scores          Score[]
  remarks         ReportRemark[]

  @@index([currentSchoolId])
  @@index([surname, firstName, dateOfBirth])
}

/// A student's time at one school. Only one enrolment per student is open (leftOn is null).
model Enrolment {
  id              String      @id @default(uuid()) @db.Uuid
  studentId       String      @db.Uuid
  student         Student     @relation(fields: [studentId], references: [id])
  schoolId        String      @db.Uuid
  school          School      @relation(fields: [schoolId], references: [id])
  admissionNumber String
  admittedOn      DateTime    @db.Date
  /// Class level the student joined at, used to allocate them to an arm later.
  entryLevel      ClassLevel?
  leftOn          DateTime?   @db.Date
  leftReason      String?
  createdAt       DateTime    @default(now())

  @@unique([schoolId, admissionNumber])
  @@index([studentId])
}

/// Which class a student is in for a session. One per student per session.
model ClassPlacement {
  id         String          @id @default(uuid()) @db.Uuid
  studentId  String          @db.Uuid
  student    Student         @relation(fields: [studentId], references: [id])
  classArmId String          @db.Uuid
  classArm   ClassArm        @relation(fields: [classArmId], references: [id])
  sessionId  String          @db.Uuid
  session    AcademicSession @relation(fields: [sessionId], references: [id])
  placedAt   DateTime        @default(now())

  @@unique([studentId, sessionId])
  @@index([classArmId])
}

/// Links a parent account to a student.
model StudentGuardian {
  studentId    String   @db.Uuid
  student      Student  @relation(fields: [studentId], references: [id])
  parentId     String   @db.Uuid
  parent       User     @relation(fields: [parentId], references: [id])
  relationship String
  createdAt    DateTime @default(now())

  @@id([studentId, parentId])
  @@index([parentId])
}

/// Moving a student from one school to another. The receiving school must accept.
model Transfer {
  id            String         @id @default(uuid()) @db.Uuid
  studentId     String         @db.Uuid
  student       Student        @relation(fields: [studentId], references: [id])
  fromSchoolId  String         @db.Uuid
  fromSchool    School         @relation("TransferFrom", fields: [fromSchoolId], references: [id])
  toSchoolId    String         @db.Uuid
  toSchool      School         @relation("TransferTo", fields: [toSchoolId], references: [id])
  status        TransferStatus @default(REQUESTED)
  reason        String
  note          String?
  requestedById String         @db.Uuid
  decidedById   String?        @db.Uuid
  requestedAt   DateTime       @default(now())
  decidedAt     DateTime?

  @@index([fromSchoolId, status])
  @@index([toSchoolId, status])
  @@index([studentId])
}

/// Counters for learner IDs and admission numbers.
model Counter {
  key   String @id
  value Int    @default(0)
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

/// One class's register for one school day.
model AttendanceRegister {
  id          String           @id @default(uuid()) @db.Uuid
  classArmId  String           @db.Uuid
  classArm    ClassArm         @relation(fields: [classArmId], references: [id])
  date        DateTime         @db.Date
  takenById   String           @db.Uuid
  takenBy     User             @relation("RegisterTakenBy", fields: [takenById], references: [id])
  takenAt     DateTime         @default(now())
  updatedById String?          @db.Uuid
  updatedBy   User?            @relation("RegisterUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime         @updatedAt
  marks       AttendanceMark[]

  @@unique([classArmId, date])
  @@index([date])
}

model AttendanceMark {
  id         String             @id @default(uuid()) @db.Uuid
  registerId String             @db.Uuid
  register   AttendanceRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  studentId  String             @db.Uuid
  student    Student            @relation(fields: [studentId], references: [id])
  status     AttendanceStatus
  note       String?

  @@unique([registerId, studentId])
  @@index([studentId])
}

/// A term within an academic session. One term is current across the state.
model Term {
  id             String          @id @default(uuid()) @db.Uuid
  sessionId      String          @db.Uuid
  session        AcademicSession @relation(fields: [sessionId], references: [id])
  number         Int
  startDate      DateTime        @db.Date
  endDate        DateTime        @db.Date
  isCurrent      Boolean         @default(false)
  /// Assessment components, e.g. [{"key":"CA1","label":"CA 1","max":20}, ...]; maxima add up to 100.
  components     Json
  showPositions  Boolean         @default(true)
  /// Grading scale for senior secondary classes: WAEC (A1 to F9) or BASIC (A to F).
  sssGrading     SssGrading      @default(WAEC)
  /// Date by which schools should release this term's results.
  resultsDueOn   DateTime?       @db.Date
  /// When set, score entry is closed for this term even while it is current.
  scoresClosedAt DateTime?
  examPapers     ExamPaper[]
  createdAt      DateTime        @default(now())
  sheets         ScoreSheet[]
  results        ClassResult[]
  remarks        ReportRemark[]

  @@unique([sessionId, number])
}

/// A subject taken by a class, and who teaches it.
model ClassSubject {
  id          String       @id @default(uuid()) @db.Uuid
  classArmId  String       @db.Uuid
  classArm    ClassArm     @relation(fields: [classArmId], references: [id])
  subjectCode String
  teacherId   String?      @db.Uuid
  teacher     User?        @relation(fields: [teacherId], references: [id])
  createdAt   DateTime     @default(now())
  sheets      ScoreSheet[]

  @@unique([classArmId, subjectCode])
  @@index([teacherId])
}

enum SssGrading {
  WAEC
  BASIC
}

enum SheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

/// One subject's scores for one class in one term, approved by the school.
model ScoreSheet {
  id             String       @id @default(uuid()) @db.Uuid
  classSubjectId String       @db.Uuid
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id])
  termId         String       @db.Uuid
  term           Term         @relation(fields: [termId], references: [id])
  status         SheetStatus  @default(DRAFT)
  submittedById  String?      @db.Uuid
  submittedBy    User?        @relation("SheetSubmittedBy", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  decidedById    String?      @db.Uuid
  decidedBy      User?        @relation("SheetDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  returnNote     String?
  updatedAt      DateTime     @updatedAt
  scores         Score[]

  @@unique([classSubjectId, termId])
  @@index([termId])
}

model Score {
  id        String     @id @default(uuid()) @db.Uuid
  sheetId   String     @db.Uuid
  sheet     ScoreSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  studentId String     @db.Uuid
  student   Student    @relation(fields: [studentId], references: [id])
  /// Marks per component key, e.g. {"CA1": 18, "CA2": 15, "EXAM": 52}.
  marks     Json
  /// Set when every component has a mark.
  total     Float?
  updatedAt DateTime   @updatedAt

  @@unique([sheetId, studentId])
  @@index([studentId])
}

/// A class's term results, released to parents and the Ministry.
model ClassResult {
  id           String   @id @default(uuid()) @db.Uuid
  classArmId   String   @db.Uuid
  classArm     ClassArm @relation(fields: [classArmId], references: [id])
  termId       String   @db.Uuid
  term         Term     @relation(fields: [termId], references: [id])
  releasedById String   @db.Uuid
  releasedBy   User     @relation(fields: [releasedById], references: [id])
  releasedAt   DateTime @default(now())

  @@unique([classArmId, termId])
}

/// Class teacher's and principal's remarks on a student's report card.
model ReportRemark {
  id              String   @id @default(uuid()) @db.Uuid
  studentId       String   @db.Uuid
  student         Student  @relation(fields: [studentId], references: [id])
  termId          String   @db.Uuid
  term            Term     @relation(fields: [termId], references: [id])
  classArmId      String   @db.Uuid
  classArm        ClassArm @relation(fields: [classArmId], references: [id])
  teacherRemark   String?
  principalRemark String?
  updatedAt       DateTime @updatedAt

  @@unique([studentId, termId])
}

enum SyncStatus {
  APPLIED
  REJECTED
}

/// A change sent from a phone, recorded once by the sync service so a retried upload is never applied twice.
/// Written only by eduos-sync; the client generates the id.
model SyncEvent {
  id         String     @id @db.Uuid
  userId     String     @db.Uuid
  deviceId   String
  type       String
  occurredAt DateTime
  receivedAt DateTime   @default(now())
  status     SyncStatus
  httpStatus Int
  result     Json?

  @@index([userId, receivedAt])
}

/// A public holiday or other state-wide non-school day set by the Ministry. Registers are not taken on these days.
model Holiday {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  startDate   DateTime @db.Date
  /// Same as startDate for a one-day holiday.
  endDate     DateTime @db.Date
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([startDate, name])
  @@index([startDate, endDate])
}

// ---------- Absence SMS ----------

enum SmsStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

/// One text message to one phone. Absence texts are queued when a register is saved and sent after a short delay,
/// so a corrected register cancels them. At most one per child, parent and day.
model SmsMessage {
  id         String    @id @default(uuid()) @db.Uuid
  kind       String
  to         String
  body       String
  schoolId   String?   @db.Uuid
  studentId  String?   @db.Uuid
  parentId   String?   @db.Uuid
  date       DateTime? @db.Date
  status     SmsStatus @default(QUEUED)
  sendAfter  DateTime
  attempts   Int       @default(0)
  provider   String?
  providerId String?
  cost       String?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sentAt     DateTime?

  @@unique([kind, studentId, parentId, date])
  @@index([status, sendAfter])
  @@index([schoolId, createdAt])
}

// ---------- Staff registry ----------

enum StaffCategory {
  TEACHING
  NON_TEACHING
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  LEFT
  RETIRED
}

enum PostingStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

/// A member of staff in a school, with or without a sign-in account.
model Staff {
  id               String            @id @default(uuid()) @db.Uuid
  staffNumber      String            @unique
  surname          String
  firstName        String
  middleName       String?
  sex              Sex
  dateOfBirth      DateTime?         @db.Date
  phone            String?
  email            String?
  category         StaffCategory
  /// Job title or cadre, e.g. Principal, Vice Principal, Teacher, Bursar.
  rank             String?
  gradeLevel       Int?
  step             Int?
  firstAppointment DateTime?         @db.Date
  /// Teachers Registration Council of Nigeria number.
  trcnNumber       String?
  /// Subject codes the person is qualified to teach.
  subjects         String[]
  status           StaffStatus       @default(ACTIVE)
  currentSchoolId  String?           @db.Uuid
  currentSchool    School?           @relation("StaffCurrentSchool", fields: [currentSchoolId], references: [id])
  userId           String?           @unique @db.Uuid
  user             User?             @relation(fields: [userId], references: [id])
  createdById      String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  qualifications   Qualification[]
  postings         Posting[]
  postingRequests  PostingRequest[]
  trainings        Training[]
  attendance       StaffAttendance[]

  @@index([currentSchoolId])
  @@index([surname, firstName])
}

model Qualification {
  id          String   @id @default(uuid()) @db.Uuid
  staffId     String   @db.Uuid
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// e.g. NCE, B.Ed, B.Sc, PGDE, M.Ed, SSCE.
  kind        String
  course      String?
  institution String?
  year        Int?
  createdAt   DateTime @default(now())
}

/// Where someone worked and when. The open posting (no end date) is their current school.
model Posting {
  id          String    @id @default(uuid()) @db.Uuid
  staffId     String    @db.Uuid
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  schoolId    String    @db.Uuid
  school      School    @relation(fields: [schoolId], references: [id])
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  reason      String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())

  @@index([staffId, startDate])
  @@index([schoolId])
}

/// A request to move staff to another school. Schools request; the Ministry approves.
model PostingRequest {
  id            String        @id @default(uuid()) @db.Uuid
  staffId       String        @db.Uuid
  staff         Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  fromSchoolId  String?       @db.Uuid
  toSchoolId    String        @db.Uuid
  reason        String
  effectiveDate DateTime      @db.Date
  status        PostingStatus @default(REQUESTED)
  note          String?
  requestedById String        @db.Uuid
  decidedById   String?       @db.Uuid
  requestedAt   DateTime      @default(now())
  decidedAt     DateTime?

  @@index([status])
  @@index([staffId])
}

model Training {
  id          String    @id @default(uuid()) @db.Uuid
  staffId     String    @db.Uuid
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  title       String
  provider    String?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  hours       Int?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())

  @@index([staffId])
}

// ---------- Infrastructure inspections ----------

/// A visit to a school recording the state of classrooms, toilets, water, power and safety.
model Inspection {
  id           String            @id @default(uuid()) @db.Uuid
  /// Set by the phone that recorded it, so a retried upload is saved once.
  clientId     String            @unique
  schoolId     String            @db.Uuid
  school       School            @relation(fields: [schoolId], references: [id])
  inspectorId  String            @db.Uuid
  inspector    User              @relation(fields: [inspectorId], references: [id])
  visitedOn    DateTime          @db.Date
  /// Checklist version the answers follow.
  template     Int               @default(1)
  answers      Json
  /// GOOD, FAIR, POOR or CRITICAL, worked out from the answers.
  overall      String
  notes        String?
  /// What happens next: URGENT, PLANNED or RESOLVED. Set by the Ministry or the LGA.
  followUp     String?
  followUpNote String?
  followUpById String?           @db.Uuid
  followUpAt   DateTime?
  createdAt    DateTime          @default(now())
  photos       InspectionPhoto[]

  @@index([schoolId, visitedOn])
  @@index([inspectorId])
}

model InspectionPhoto {
  id           String     @id @default(uuid()) @db.Uuid
  clientId     String     @unique
  inspectionId String     @db.Uuid
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  section      String
  caption      String?
  contentType  String
  bytes        Int
  /// Where the image is: an object key in S3-compatible storage, or "db" when kept in `data` (development).
  storageKey   String
  data         Bytes?
  createdAt    DateTime   @default(now())

  @@index([inspectionId])
}

// ---------- Notifications ----------

/// Something a person should know about, shown in their inbox on the web and the app (and pushed to their phone
/// when push is set up). Notifications with a key are made at most once per person.
model Notification {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ABSENCE, RESULTS, TRANSFER or NOTICE.
  kind         String
  title        String
  body         String
  /// Where it leads in the apps, e.g. /report-card/<student id>?term=<term id>.
  link         String?
  studentId    String?   @db.Uuid
  key          String?
  /// Hidden until then (absence notices wait like the absence text, so a corrected register cancels them).
  visibleAfter DateTime  @default(now())
  readAt       DateTime?
  pushedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, key])
  @@index([userId, visibleAfter])
  @@index([pushedAt, visibleAfter])
}

/// A phone that receives push notifications for a signed-in person.
model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// A message from a school to its parents, or to the parents of one class.
model Notice {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @db.Uuid
  school     School   @relation(fields: [schoolId], references: [id])
  classArmId String?  @db.Uuid
  /// PARENTS or STAFF.
  audience   String   @default("PARENTS")
  title      String
  body       String
  sms        Boolean  @default(false)
  recipients Int
  sentById   String   @db.Uuid
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
}

// ---------- Prototype parity: settings, exams, population, staff attendance, report card codes ----------

/// State-wide settings the Ministry can change, such as the grading scales.
model Setting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

/// One paper in a school's examination timetable for a class level and term.
model ExamPaper {
  id          String     @id @default(uuid()) @db.Uuid
  schoolId    String     @db.Uuid
  termId      String     @db.Uuid
  term        Term       @relation(fields: [termId], references: [id])
  level       ClassLevel
  subjectCode String
  date        DateTime   @db.Date
  /// Start time, HH:MM.
  startTime   String
  minutes     Int
  updatedAt   DateTime   @updatedAt

  @@unique([schoolId, termId, level, subjectCode])
  @@index([termId, level])
}

/// School-age population estimate for an LGA, used for enrolment ratios (GER, NER) and out-of-school figures.
model PopulationEstimate {
  id        String   @id @default(uuid()) @db.Uuid
  lga       String
  year      Int
  /// PRIMARY (ages 6 to 11), JSS (12 to 14) or SSS (15 to 17).
  stage     String
  male      Int
  female    Int
  source    String?
  updatedAt DateTime @updatedAt

  @@unique([lga, year, stage])
}

enum StaffAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
}

/// A member of staff's attendance for one school day.
model StaffAttendance {
  id          String                @id @default(uuid()) @db.Uuid
  staffId     String                @db.Uuid
  staff       Staff                 @relation(fields: [staffId], references: [id], onDelete: Cascade)
  schoolId    String                @db.Uuid
  date        DateTime              @db.Date
  status      StaffAttendanceStatus
  /// Set when the teacher clocked in from the app.
  clockedInAt DateTime?
  markedById  String?               @db.Uuid
  updatedAt   DateTime              @updatedAt

  @@unique([staffId, date])
  @@index([schoolId, date])
}

/// The code printed on a report card so anyone can check it against EduOS records.
model ReportCode {
  code      String   @id
  studentId String   @db.Uuid
  termId    String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([studentId, termId])
}
