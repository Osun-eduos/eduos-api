# PostgreSQL connection
DATABASE_URL=postgresql://eduos:eduos@localhost:5432/eduos?schema=public

# Secret for signing access tokens: at least 32 random characters.
# Generate one with:  openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret

# How long access tokens last, and how many days a sign-in lasts before asking again
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=14

# Web app address(es) allowed to call the API, comma-separated
WEB_ORIGIN=http://localhost:5173

# Set to false only for local development over plain http
COOKIE_SECURE=false

# The refresh cookie. Host the web app and API on the same site (e.g. app.example.gov.ng and
# api.example.gov.ng, or the API under /api on the web app's domain) so SameSite=strict works.
# COOKIE_SAMESITE=strict
# COOKIE_PATH=/

# Sign-in attempts allowed per IP address per minute
LOGIN_RATE_LIMIT=30

# Number of proxies in front of the API (for correct client IPs), e.g. 1 behind a load balancer
# TRUST_PROXY=1

PORT=3000

# Used once by `npm run db:seed` to create the first Ministry administrator
SEED_ADMIN_NAME=Ministry Administrator
SEED_ADMIN_EMAIL=admin@example.gov.ng

# Absence texts to parents (KudiSMS). Without a token and sender ID, texts are logged instead of sent.
# KUDISMS_ROUTE=corporate uses the transactional route (needs an approved corporate sender ID; reaches DND numbers).
# KUDISMS_ROUTE=sms uses the bulk route (promotional sender ID; DND numbers are skipped and refunded).
KUDISMS_TOKEN=
KUDISMS_SENDER_ID=
KUDISMS_ROUTE=corporate
ABSENCE_SMS_DELAY_MINUTES=15
# SMS_WORKER=off stops this instance sending (for example on a second instance).

# Inspection photos. Leave S3_BUCKET empty to keep photos in the database (development only).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Push notifications to the parent app: the Firebase service account JSON (or the same, base64-encoded).
# Without it, parents still see notifications in their inbox and get the important ones by SMS.
FIREBASE_SERVICE_ACCOUNT=
