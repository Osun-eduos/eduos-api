# PostgreSQL connection
DATABASE_URL=postgresql://eduos:eduos@localhost:5432/eduos?schema=public

# Secret for signing access tokens: at least 32 random characters.
# Generate one with:  openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret

# How long access tokens last, and how many days a sign-in lasts before asking again
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=14

# Web app address(es) allowed to call the API, comma-separated
WEB_ORIGIN=http://localhost:5173

# Set to false only for local development over plain http
COOKIE_SECURE=false

# The refresh cookie. Host the web app and API on the same site (e.g. app.example.gov.ng and
# api.example.gov.ng, or the API under /api on the web app's domain) so SameSite=strict works.
# COOKIE_SAMESITE=strict
# COOKIE_PATH=/

# Sign-in attempts allowed per IP address per minute
LOGIN_RATE_LIMIT=30

# Number of proxies in front of the API (for correct client IPs), e.g. 1 behind a load balancer
# TRUST_PROXY=1

PORT=3000

# Used once by `npm run db:seed` to create the first Ministry administrator
SEED_ADMIN_NAME=Ministry Administrator
SEED_ADMIN_EMAIL=admin@example.gov.ng
